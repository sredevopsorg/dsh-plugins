{
  "name": "@sredevopsorg/dsh-suggest-resources",
  "version": "1.0.2",
  "description": "Suggest tools, plugins, MCP servers, and skills for a task.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sredevopsorg/dsh-plugins.git",
    "directory": "plugins/suggest-resources"
  },
  "homepage": "https://github.com/sredevopsorg/dsh-plugins/tree/main/plugins/suggest-resources#readme",
  "bugs": {
    "url": "https://github.com/sredevopsorg/dsh-plugins/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "catalog.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "suggestions",
    "discovery",
    "mcp",
    "skills"
  ],
  "engines": {
    "dsh": "^0.2.1-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
