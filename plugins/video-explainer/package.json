{
  "name": "@sredevopsorg/dsh-video-explainer",
  "version": "0.1.0",
  "description": "Video Explainer for DeepSeek Harness: turn a topic, doc, codebase, or URL into a ~1-minute explainer video in Motion, Illustrated, or 3D style, with a frame-pinned review page.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sredevopsorg/dsh-plugins.git",
    "directory": "plugins/video-explainer"
  },
  "homepage": "https://github.com/sredevopsorg/dsh-plugins/tree/main/plugins/video-explainer#readme",
  "bugs": {
    "url": "https://github.com/sredevopsorg/dsh-plugins/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./skills/*": "./skills/*"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "test/*.test.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs",
    "skills"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js && for f in test/*.test.mjs; do node --check \"$f\" || exit 1; done"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "video",
    "video-explainer",
    "explainer",
    "animation",
    "hyperframes",
    "motion-graphics",
    "ffmpeg",
    "skill"
  ],
  "engines": {
    "dsh": "^0.2.1-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
